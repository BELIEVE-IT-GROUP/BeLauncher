# BeLauncher configuration. Copy to .env; .env is git-ignored and never committed.
#
# BeLauncher works with no .env at all: everything here is optional.
# Real secrets do NOT belong in this file — store them in the macOS Keychain from
# Settings › Secrets, and reference them in snippets or workflow URLs as {secret:NAME}.

# Optional JSON feed used by the opt-in update check.
# Expected shape: {"version": "0.2.0", "url": "https://…", "notes": "…"}
# Leave empty to keep BeLauncher completely offline.
BELAUNCHER_UPDATE_FEED_URL=https://files.believe-global.com/apps/belauncher/latest.json
